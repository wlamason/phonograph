{
  "name": "phonograph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "models": "blender -b --factory-startup --python-exit-code 1 --python models/turntables/classic_belt_drive/build.py",
    "audio": "python scripts/build_audio.py",
    "rebuild": "npm run models && npm run audio && npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "6.4.1"
  }
}
